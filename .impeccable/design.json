  "narrative": {
    "keyCharacteristics": [
      "Game-dominant viewport.",
      "Restrained native controls.",
      "Readable Vietnamese system typography.",
      "Help available on demand."
    ],
    "overview": "The actual Viva La RTS game supplies the visual interest. The owned interface is a quiet, compact Vietnamese workbench: a control row, a large game viewport, a status line and an optional help drawer. Charcoal surfaces, ivory text and small bronze accents support play without competing with it.\n\nThis records the implemented wrapper in index.html and style.css, rather than the third-party game's internal design. There is no approved image comp: the current interface is code-led. The confirmed direction rejects a landing-page grid and generated decorative artwork.",
    "northStar": "Game-first workbench",
    "rules": [
      {
        "name": "The Game Leads Rule",
        "body": "Keep the wrapper subdued so the live game remains the strongest visual surface.",
        "section": "colors"
      },
      {
        "name": "The Available Space Rule",
        "body": "New wrapper content must preserve the flexible game region instead of pushing the game below a promotional section.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do let the actual game lead the screen.",
      "Do use natural Vietnamese and preserve visible keyboard focus.",
      "Do keep support in the optional drawer and preserve usable control targets."
    ],
    "donts": [
      "Don't introduce a landing grid or generated decorative art.",
      "Don't claim the wrapper controls or translates the third-party game's internal menu.",
      "Don't treat portrait mobile presentation as evidence of comfortable touch gameplay."
    ]
  },
